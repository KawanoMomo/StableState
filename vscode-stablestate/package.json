{
  "name": "stablestate",
  "displayName": "StableState",
  "description": "UML State Machine Diagram Editor with DSL",
  "version": "0.1.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Visualization"],
  "activationEvents": ["onLanguage:stablestate"],
  "main": "./src/extension.js",
  "scripts": {
    "vscode:prepublish": "cp ../stablestate.html ./stablestate.html"
  },
  "contributes": {
    "languages": [{
      "id": "stablestate",
      "aliases": ["StableState", "stablestate"],
      "extensions": [".sstate"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "stablestate",
      "scopeName": "source.stablestate",
      "path": "./syntaxes/stablestate.tmLanguage.json"
    }],
    "commands": [
      { "command": "stablestate.preview", "title": "StableState: Open Preview" },
      { "command": "stablestate.exportSVG", "title": "StableState: Export SVG" },
      { "command": "stablestate.exportPNG", "title": "StableState: Export PNG" },
      { "command": "stablestate.undo", "title": "StableState: Undo" },
      { "command": "stablestate.redo", "title": "StableState: Redo" },
      { "command": "stablestate.copy", "title": "StableState: Copy" },
      { "command": "stablestate.cut", "title": "StableState: Cut" },
      { "command": "stablestate.paste", "title": "StableState: Paste" },
      { "command": "stablestate.selectAll", "title": "StableState: Select All" },
      { "command": "stablestate.diffPreview", "title": "StableState: Visual Diff (HEAD vs Current)" }
    ],
    "keybindings": [
      { "command": "stablestate.preview", "key": "ctrl+shift+v", "when": "editorLangId == stablestate" },
      { "command": "stablestate.diffPreview", "key": "ctrl+shift+d", "when": "editorLangId == stablestate" },
      { "command": "stablestate.undo", "key": "ctrl+z", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.redo", "key": "ctrl+y", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.redo", "key": "ctrl+shift+z", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.copy", "key": "ctrl+c", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.cut", "key": "ctrl+x", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.paste", "key": "ctrl+v", "when": "stablestatePreviewFocused" },
      { "command": "stablestate.selectAll", "key": "ctrl+a", "when": "stablestatePreviewFocused" }
    ]
  }
}
